# Forward quote / consultation requests from the website to your WhatsApp.
# 1. Follow the WhatsApp setup at https://www.callmebot.com/blog/free-api-whatsapp-messages/
#    (you send an activation message from your phone and receive an API key).
# 2. Copy this file to .env.local for local testing, and add the same variables in
#    Vercel -> Project -> Settings -> Environment Variables for production.

# Your WhatsApp number in international format, digits only (e.g. 254795974284)
CALLMEBOT_PHONE=
# The API key CallMeBot sends you
CALLMEBOT_APIKEY=
